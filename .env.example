# EmailJS Configuration
# Copy this file to .env and fill in your actual credentials

# Get these from https://www.emailjs.com/

# Your EmailJS Public Key (Account > API Keys)
EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Service ID (Email Services)
EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID (Email Templates)
EMAILJS_TEMPLATE_ID=your_template_id_here

# Your email address where messages will be sent
TO_EMAIL=ganesanparkavi777@gmail.com
